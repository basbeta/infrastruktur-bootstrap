# Kopier denne fila til .env og fyll ut det prosjektet faktisk trenger.
# Ikke alt under trengs i alle prosjekter, og ingen av verdiene her er ekte.

# --- Database (PostgreSQL i Coolify) ---
DATABASE_URL=postgresql://bruker:passord@localhost:5432/dbnavn

# --- Redis (caching, sesjoner, køer) ---
REDIS_URL=redis://bruker:passord@localhost:6379

# --- S3-kompatibel objektlagring (Hetzner) ---
S3_ENDPOINT=https://ditt-endepunkt.example.com
S3_REGION=eu-central
S3_BUCKET=ditt-bucket-navn
S3_ACCESS_KEY_ID=fyll-inn-fra-coolify
S3_SECRET_ACCESS_KEY=fyll-inn-fra-coolify

# --- Transaksjonell e-post (Brevo) ---
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=fyll-inn-fra-brevo
SMTP_PASSWORD=fyll-inn-fra-brevo

# --- Feilsporing (Bugsink) ---
BUGSINK_DSN=https://eksempel@errors.basbeta.no/1

# --- Autentisering (Hanko) ---
HANKO_API_URL=https://auth.basbeta.no
